# DevUnity CodeArena — environment
PORT=8080                      # HTTP port (Render sets this automatically)
DATA_DIR=./data                # SQLite file location (dev / single-box)
DATABASE_URL=                  # Render Postgres conn string. Empty => SQLite.
AUTOSEED=1                     # Seed demo arena on first boot if DB is empty
JUDGE_CONCURRENCY=2            # Parallel sandboxed judging slots
JUDGE_MAX_CODE_BYTES=65536     # Submission size cap
SESSION_TTL_DAYS=30
